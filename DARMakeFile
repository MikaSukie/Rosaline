# Rosaline macOS/Darwin Homebrew LLVM
CXX      := /opt/homebrew/opt/llvm/bin/clang++
CXXFLAGS := -std=c++23 -O2 -Wall -Wextra -Wpedantic \
            -fcolor-diagnostics -fdiagnostics-color=always \
            -pipe -MMD -MP
LDFLAGS  :=

JOBS     := $(shell sysctl -n hw.logicalcpu 2>/dev/null || nproc 2>/dev/null || echo 4)
MAKEFLAGS += --jobs=$(JOBS)

SRCDIR  := src
BUILDDIR := build
OBJDIR  := $(BUILDDIR)/obj
DEPDIR  := $(BUILDDIR)/dep
ASMDIR  := $(BUILDDIR)/asm

SRCS := \
	$(SRCDIR)/lexer.cpp \
	$(SRCDIR)/parser.cpp \
	$(SRCDIR)/types.cpp \
	$(SRCDIR)/sema.cpp \
	$(SRCDIR)/codegen.cpp \
	$(SRCDIR)/codegen2.cpp \
	$(SRCDIR)/main.cpp

OBJS := $(patsubst $(SRCDIR)/%.cpp,$(OBJDIR)/%.o,$(SRCS))
DEPS := $(patsubst $(SRCDIR)/%.cpp,$(DEPDIR)/%.d,$(SRCS))

TARGET := rosaline

ifdef DEBUG
  CXXFLAGS += -g -O0 -fsanitize=address,undefined -DDEBUG
  LDFLAGS  += -fsanitize=address,undefined
endif

-include $(DEPS)

.PHONY: all clean test asm asm-all help

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(OBJS) -o $@ $(LDFLAGS)
	@echo "Built: $@"

$(OBJDIR)/%.o: $(SRCDIR)/%.cpp
	@mkdir -p $(OBJDIR) $(DEPDIR)
	$(CXX) $(CXXFLAGS) -MF $(DEPDIR)/$*.d -c $< -o $@

asm:
	@test -n "$(ASMFILE)" || (echo "usage: make -f DARMakeFile asm ASMFILE=src/file.cpp" && exit 1)
	@mkdir -p $(ASMDIR)
	$(CXX) $(CXXFLAGS) -S "$(ASMFILE)" -o "$(ASMDIR)/$(notdir $(ASMFILE:.cpp=.s))"
	@echo "Wrote: $(ASMDIR)/$(notdir $(ASMFILE:.cpp=.s))"

asm-all:
	@mkdir -p $(ASMDIR)
	@for f in $(SRCS); do \
		$(CXX) $(CXXFLAGS) -S $$f -o $(ASMDIR)/$$(basename $${f%.cpp}.s); \
	done
	@echo "Wrote assembly for all sources to $(ASMDIR)/"

test: all
	@echo "=== Running tests ==="
	@$(MAKE) -f DARMakeFile -C tests run COMPILER=../$(TARGET) --no-print-directory

clean:
	rm -rf $(BUILDDIR) $(TARGET)
	rm -f tests/*.ll tests/*.out *.ll main

help:
	@echo "macOS/Darwin build (Homebrew LLVM at /opt/homebrew/opt/llvm)"
	@echo "Targets: all (default), clean, test, asm ASMFILE=<file>, asm-all, help"
	@echo "Options: DEBUG=1  – add AddressSanitizer + debug info"
	@echo "         -j<N>    – override parallelism (default: hw.logicalcpu=$(JOBS))"
