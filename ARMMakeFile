CXX := clang++-19
CXXFLAGS := -std=c++2b -stdlib=libc++
LDFLAGS  := -stdlib=libc++
LDLIBS   := -lc++abi
MAKEFLAGS += -j$(shell nproc)

SRCDIR  := src
BUILDDIR := build
OBJDIR  := $(BUILDDIR)/obj
DEPDIR  := $(BUILDDIR)/dep
ASMDIR  := $(BUILDDIR)/asm

SRCS := \
	$(SRCDIR)/lexer.cpp \
	$(SRCDIR)/parser.cpp \
	$(SRCDIR)/types.cpp \
	$(SRCDIR)/sema.cpp \
	$(SRCDIR)/codegen.cpp \
	$(SRCDIR)/codegen2.cpp \
	$(SRCDIR)/main.cpp

OBJS := $(patsubst $(SRCDIR)/%.cpp,$(OBJDIR)/%.o,$(SRCS))
DEPS := $(patsubst $(SRCDIR)/%.cpp,$(DEPDIR)/%.d,$(SRCS))

TARGET := rosaline

CXXFLAGS += -MMD -MP
CXXFLAGS += -fdiagnostics-color=always

ifdef DEBUG
  CXXFLAGS += -g -O0 -fsanitize=address,undefined -DDEBUG
  LDFLAGS  += -fsanitize=address,undefined
endif

-include $(DEPS)

.PHONY: all clean test asm

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(OBJS) -o $@ $(LDFLAGS)
	@echo "Built: $@"

$(OBJDIR)/%.o: $(SRCDIR)/%.cpp
	@mkdir -p $(dir $@) $(DEPDIR)
	$(CXX) $(CXXFLAGS) -MF $(patsubst $(OBJDIR)/%.o,$(DEPDIR)/%.d,$@) -c $< -o $@

asm:
	@test -n "$(ASMFILE)" || (echo "usage: make asm ASMFILE=src/file.cpp" && exit 1)
	@mkdir -p $(ASMDIR)
	$(CXX) $(CXXFLAGS) -S "$(ASMFILE)" -o "$(ASMDIR)/$$(basename "$(notdir "$(ASMFILE)")" .cpp).s"
	@echo "Wrote: $(ASMDIR)/$$(basename "$(notdir "$(ASMFILE)")" .cpp).s"

test: all
	@echo "=== Running tests ==="
	@$(MAKE) -C tests run COMPILER=../$(TARGET) --no-print-directory

asm-all:
	@mkdir -p $(ASMDIR)
	@for f in $(SRCS); do \
		$(CXX) $(CXXFLAGS) -S $$f -o $(ASMDIR)/$$(basename $${f%.cpp}.s); \
	done
	@echo "Wrote assembly for all sources to $(ASMDIR)/"

clean:
	rm -rf $(BUILDDIR) $(TARGET)
	rm -f tests/*.ll tests/*.out
	rm -f *.ll main
