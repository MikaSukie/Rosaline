CXX      := x86_64-w64-mingw32-g++
CXXFLAGS := -std=c++23 -O2 -Wall -Wextra -Wpedantic
MAKEFLAGS += -j$(shell nproc)
LDFLAGS  := -static -static-libgcc -static-libstdc++

SRCDIR  := src
BUILDDIR := build-win
OBJDIR  := $(BUILDDIR)/obj
DEPDIR  := $(BUILDDIR)/dep
ASMDIR  := $(BUILDDIR)/asm

SRCS := \
	$(SRCDIR)/lexer.cpp \
	$(SRCDIR)/parser.cpp \
	$(SRCDIR)/types.cpp \
	$(SRCDIR)/sema.cpp \
	$(SRCDIR)/codegen.cpp \
	$(SRCDIR)/codegen2.cpp \
	$(SRCDIR)/main.cpp

OBJS := $(patsubst $(SRCDIR)/%.cpp,$(OBJDIR)/%.o,$(SRCS))
DEPS := $(patsubst $(SRCDIR)/%.cpp,$(DEPDIR)/%.d,$(SRCS))

TARGET := rosaline.exe

CXXFLAGS += -MMD -MP

ifdef DEBUG
	CXXFLAGS += -g -O0 -DDEBUG
endif

-include $(DEPS)

.PHONY: all clean asm

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(OBJS) -o $@ $(LDFLAGS)
	@echo "Built: $@"

$(OBJDIR)/%.o: $(SRCDIR)/%.cpp
	@mkdir -p $(dir $@) $(DEPDIR)
	$(CXX) $(CXXFLAGS) -MF $(patsubst $(OBJDIR)/%.o,$(DEPDIR)/%.d,$@) -c $< -o $@

asm:
	@test -n "$(ASMFILE)" || (echo "usage: make -f Makefile.win asm ASMFILE=src/file.cpp" && exit 1)
	@mkdir -p $(ASMDIR)
	$(CXX) $(CXXFLAGS) -S "$(ASMFILE)" -o "$(ASMDIR)/$$(basename "$(notdir "$(ASMFILE)")" .cpp).s"

clean:
	rm -rf $(BUILDDIR) $(TARGET)