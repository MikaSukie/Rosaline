# Rosaline Win cross compile (MinGW-w64)
CXX      := x86_64-w64-mingw32-g++
CXXFLAGS := -std=c++23 -O2 -Wall -Wextra -Wpedantic \
            -pipe -MMD -MP
LDFLAGS  := -static -static-libgcc -static-libstdc++

JOBS     := $(shell nproc 2>/dev/null || echo 4)
MAKEFLAGS += --jobs=$(JOBS)

SRCDIR  := src
BUILDDIR := build-win
OBJDIR  := $(BUILDDIR)/obj
DEPDIR  := $(BUILDDIR)/dep
ASMDIR  := $(BUILDDIR)/asm

SRCS := \
	$(SRCDIR)/lexer.cpp \
	$(SRCDIR)/parser.cpp \
	$(SRCDIR)/types.cpp \
	$(SRCDIR)/sema.cpp \
	$(SRCDIR)/codegen.cpp \
	$(SRCDIR)/codegen2.cpp \
	$(SRCDIR)/main.cpp

OBJS := $(patsubst $(SRCDIR)/%.cpp,$(OBJDIR)/%.o,$(SRCS))
DEPS := $(patsubst $(SRCDIR)/%.cpp,$(DEPDIR)/%.d,$(SRCS))

TARGET := rosaline.exe

ifdef DEBUG
  CXXFLAGS += -g -O0 -DDEBUG
endif

-include $(DEPS)

.PHONY: all clean asm asm-all help

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(OBJS) -o $@ $(LDFLAGS)
	@echo "Built: $@"

$(OBJDIR)/%.o: $(SRCDIR)/%.cpp
	@mkdir -p $(OBJDIR) $(DEPDIR)
	$(CXX) $(CXXFLAGS) -MF $(DEPDIR)/$*.d -c $< -o $@

asm:
	@test -n "$(ASMFILE)" || (echo "usage: make -f WINMakeFile asm ASMFILE=src/file.cpp" && exit 1)
	@mkdir -p $(ASMDIR)
	$(CXX) $(CXXFLAGS) -S "$(ASMFILE)" -o "$(ASMDIR)/$(notdir $(ASMFILE:.cpp=.s))"
	@echo "Wrote: $(ASMDIR)/$(notdir $(ASMFILE:.cpp=.s))"

asm-all:
	@mkdir -p $(ASMDIR)
	@for f in $(SRCS); do \
		$(CXX) $(CXXFLAGS) -S $$f -o $(ASMDIR)/$$(basename $${f%.cpp}.s); \
	done
	@echo "Wrote assembly for all sources to $(ASMDIR)/"

clean:
	rm -rf $(BUILDDIR) $(TARGET)
	rm -f tests/*.ll tests/*.out *.ll

help:
	@echo "Windows cross-compile build (x86_64-w64-mingw32-g++)"
	@echo "Targets: all (default), clean, asm ASMFILE=<file>, asm-all, help"
	@echo "Options: DEBUG=1  – add debug info"
	@echo "         -j<N>    – override parallelism (default: nproc=$(JOBS))"
